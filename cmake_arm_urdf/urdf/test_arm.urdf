<?xml version="1.0" ?>
<robot name="low_cost_robot">

  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="first_bracket_motor_1"/>
    <origin xyz="0 0.07 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14158" upper="3.14158" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="first_bracket_motor_1">
    <visual>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/first-bracket-motor_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/first-bracket-motor_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2 -->
  <joint name="joint2" type="revolute">
    <parent link="first_bracket_motor_1"/>
    <child link="shoulder_to_elbow_motor">
    <origin xyz="0 0 0.055"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14158" upper="3.14158" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="shoulder_to_elbow_motor">
    <visual>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/shoulder-to-elbow-motor_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/shoulder-to-elbow-motor_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 3 -->
  <joint name="joint3" type="revolute">
    <parent link="shoulder_to_elbow_motor"/>
    <child link="elbow_to_wrist_with_motor">
    <origin xyz="0.0 0.0135 0.108"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14158" upper="3.14158" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="elbow_to_wrist_with_motor">
    <visual>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/elbow_to_wrist_with_motor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/elbow_to_wrist_with_motor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 4 -->
  <joint name="joint4" type="revolute">
    <parent link="elbow_to_wrist_with_motor"/>
    <child link="elbow_to_wrist_motor_reference">
    <origin xyz="0 0.091 0.0035"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14158" upper="3.14158" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="elbow_to_wrist_motor_reference">
    <visual>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/elbow-to-wrist-motor-reference_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/elbow-to-wrist-motor-reference_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 5 -->
  <joint name="joint5" type="revolute">
    <parent link="elbow_to_wrist_motor_reference"/>
    <child link="gripper_static_motor">
    <origin xyz="0 0.04 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14158" upper="3.14158" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="gripper_static_motor">
    <visual>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/gripper-static-motor-pt1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/gripper-static-motor-pt1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 6 -->
  <joint name="joint6" type="revolute">
    <parent link="gripper_static_motor"/>
    <child link="gripper_moving_part">
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.45" upper="0.032" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="gripper_moving_part">
    <visual>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/gripper-moving-part-dumb_v2_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cmake_arm_urdf/meshes/gripper-moving-part-dumb_v2_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Actuators -->
  <actuator>
    <position joint="joint1" name="joint1_motor"/>
    <position joint="joint2" name="joint2_motor"/>
    <position joint="joint3" name="joint3_motor"/>
    <position joint="joint4" name="joint4_motor"/>
    <position joint="joint5" name="joint5_motor"/>
    <position joint="joint6" name="joint6_motor"/>
  </actuator>

</robot>
